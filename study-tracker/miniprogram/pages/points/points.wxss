.container {
  padding: 0 30rpx 40rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4f8 0%, #e8edf2 100%);
}

.points-hero {
  background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  margin: 30rpx 0;
  text-align: center;
  color: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(243, 156, 18, 0.3);
  animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
}

.points-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.points-value-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 20rpx 0 16rpx;
}

.points-value {
  font-size: 100rpx;
  font-weight: 900;
  line-height: 1;
}

.points-unit {
  font-size: 36rpx;
  font-weight: 600;
  margin-left: 12rpx;
}

.points-hint {
  font-size: 22rpx;
  line-height: 1.7;
  opacity: 0.82;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.detail-card {
  animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  animation-delay: 0.1s;
}

.rules-card {
  animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  animation-delay: 0.2s;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 24rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-label {
  font-size: 28rpx;
  color: #7f8c8d;
}

.detail-value {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
}

.detail-value.discount {
  color: #e6a23c;
}

.detail-value.highlight {
  color: #e67e22;
  font-weight: 700;
}

.detail-value.positive {
  color: #27ae60;
}

.detail-value.negative {
  color: #e67e22;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #f39c12;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 40rpx;
}

.footer-tip {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #95a5a6;
}
