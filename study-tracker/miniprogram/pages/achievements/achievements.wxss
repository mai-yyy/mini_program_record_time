.container {
  min-height: 100vh;
  padding: 30rpx;
  background: linear-gradient(180deg, #f4f8fc 0%, #eaf0f7 100%);
  box-sizing: border-box;
}

.hero-card {
  padding: 36rpx 34rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #243447, #3e5f82);
  color: #ffffff;
  box-shadow: 0 20rpx 44rpx rgba(36, 52, 71, 0.2);
}

.hero-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  opacity: 0.72;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.88;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 26rpx;
}

.metric-chip {
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.metric-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.76;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.section-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 36rpx rgba(31, 45, 61, 0.06);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #243447;
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.badge-card {
  padding: 24rpx 22rpx;
  border-radius: 26rpx;
  border: 2rpx solid transparent;
}

.badge-card.unlocked {
  background: linear-gradient(180deg, #ffffff, #f8fbff);
  border-color: rgba(74, 144, 217, 0.14);
}

.badge-card.locked {
  background: linear-gradient(180deg, #f5f7fa, #eef2f6);
  opacity: 0.82;
}

.badge-icon {
  display: inline-flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(74, 144, 217, 0.12);
  font-size: 34rpx;
}

.badge-name {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #243447;
}

.badge-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7f8c8d;
  min-height: 72rpx;
}

.badge-progress {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #4A90D9;
}

.loading-wrap {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #8b98a5;
}

@media (max-width: 420px) {
  .hero-metrics,
  .badge-grid {
    grid-template-columns: 1fr;
  }
}
