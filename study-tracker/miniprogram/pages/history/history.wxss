/* 页面头部 */
.page-header {
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #2c3e50;
}

/* 日期卡片 */
.day-card {
  padding: 30rpx;
  animation-delay: calc(var(--index, 0) * 0.1s);
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.day-date-info {
  display: flex;
  align-items: center;
}

.day-date {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-right: 16rpx;
}

.day-weekday {
  font-size: 24rpx;
  color: #7f8c8d;
  background: #f0f4f8;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.day-total-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.day-total-badge {
  background: linear-gradient(135deg, #eff0f1 0%, #f3f5f7 100%);
  color: #0f0b0b;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.day-discount-text {
  font-size: 26rpx;
  color: #e6a23c;
}

.day-discount-rate {
  font-size: 26rpx;
  color: #bbb;
}

/* 学习段列表 */
.day-sessions {
  padding-left: 10rpx;
}

.day-session-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  position: relative;
}

.day-session-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4A90D9;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.day-session-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.day-session-time {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.day-session-duration {
  font-size: 26rpx;
  color: #4A90D9;
  font-weight: 500;
}

.day-session-delete {
  margin-left: 20rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e74c3c;
  font-size: 36rpx;
  border-radius: 50%;
  background: #fdf2f2;
}

/* 加载中 */
.loading-wrap {
  text-align: center;
  padding: 40rpx;
}

.loading-text {
  color: #7f8c8d;
  font-size: 28rpx;
}
