.container {
  padding: 0 30rpx 40rpx;
  min-height: 100vh;
}

.section-block {
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 34rpx;
  box-shadow: 0 14rpx 36rpx rgba(31, 45, 61, 0.06);
}

.vip-card {
  margin-top: 30rpx;
  position: relative;
  overflow: hidden;
  padding: 0;
  background: transparent;
}

.vip-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.74;
  filter: brightness(1.25);
}

.vip-card-content {
  position: relative;
  z-index: 1;
  min-height: 230rpx;
  padding: 46rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: rgba(248, 247, 245, 0.72);
  backdrop-filter: blur(2rpx);
  -webkit-backdrop-filter: blur(2rpx);
}

.vip-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.vip-copy {
  display: flex;
  flex-direction: column;
}

.vip-level {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #243447;
}

.vip-desc {
  display: block;
  margin-top: 26rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5f6d7a;
}

.profile-card {
  padding: 40rpx;
}

.avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.35);
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
}

.profile-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #2c3e50;
}

.profile-gender {
  font-size: 26rpx;
  margin-left: 10rpx;
}

.profile-sub {
  font-size: 26rpx;
  color: #e6a23c;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.profile-motto {
  font-size: 24rpx;
  color: #95a5a6;
  font-style: italic;
  margin-top: 4rpx;
  max-width: 320rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-edit-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #bdc3c7;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.profile-edit-btn .arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.compact-card {
  min-height: 170rpx;
  padding: 24rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-icon {
  display: block;
  font-size: 38rpx;
  margin-bottom: 10rpx;
}

.stat-value {
  display: block;
  font-size: 54rpx;
  font-weight: 800;
  color: #2c3e50;
}

.stat-value.compact {
  line-height: 1.1;
}

.stat-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7f8c8d;
}

.achievement-entry {
  text-align: left;
}

.achievement-entry-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.achievement-entry-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #243447;
}

.achievement-entry-arrow {
  font-size: 30rpx;
  color: #bdc3c7;
  font-weight: 800;
}

.action-card {
  padding: 36rpx 40rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #243447;
}

.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
}

.action-left {
  display: flex;
  align-items: center;
}

.action-desc {
  font-size: 28rpx;
  color: #7f8c8d;
}

.arrow {
  font-size: 32rpx;
  color: #bdc3c7;
  font-weight: 800;
}

.loading-wrap {
  text-align: center;
  padding: 40rpx;
}

.loading-text {
  color: #7f8c8d;
  font-size: 28rpx;
}

@media (max-width: 420px) {
  .avatar-wrap {
    align-items: flex-start;
  }
}

.tab-enter-prep .section-block,
.tab-enter-prep .achievement-entry,
.tab-enter-prep .action-card {
  opacity: 0;
  transform: translateY(30rpx);
}

.tab-enter-active .section-block,
.tab-enter-active .achievement-entry,
.tab-enter-active .action-card {
  opacity: 1;
  transform: translateY(0);
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-enter-active .vip-card { transition-delay: 0.05s; }
.tab-enter-active .profile-card { transition-delay: 0.1s; }
.tab-enter-active .stats-grid { transition-delay: 0.15s; }
.tab-enter-active .mall-card { transition-delay: 0.2s; }
.tab-enter-active .about-card { transition-delay: 0.25s; }

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
