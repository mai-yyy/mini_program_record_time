/* 全局样式 */
page {
  background-color: #f0f4f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial,
    sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.05);
  animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
}

@keyframes slideUp {
  0% {
    opacity: 0;
    transform: translateY(40rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 主色调按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  letter-spacing: 4rpx;
  box-shadow: 0 12rpx 30rpx rgba(74, 144, 217, 0.3);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: translateY(4rpx) scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.2);
}

.btn-primary[disabled] {
  background: #e2e8f0;
  color: #a0aec0;
  box-shadow: none;
  transform: none;
}

/* 危险按钮 */
.btn-danger {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-danger::after {
  border: none;
}

/* 标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

/* 副标题 */
.section-subtitle {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 16rpx;
}

/* 大数字展示 */
.big-number {
  font-size: 72rpx;
  font-weight: 800;
  color: #4A90D9;
  line-height: 1.2;
}

.big-unit {
  font-size: 28rpx;
  font-weight: 500;
  color: #7f8c8d;
  margin-left: 8rpx;
}

@keyframes tabPageFadeIn {
  0% {
    opacity: 0;
    transform: translateY(26rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.tab-enter-prep > view {
  opacity: 0;
  transform: translateY(26rpx);
}

.tab-enter-active > view {
  opacity: 0;
  will-change: transform, opacity;
  animation: tabPageFadeIn 0.4s ease both;
}

.tab-enter-active > view:nth-child(1) {
  animation-delay: 0.04s;
}

.tab-enter-active > view:nth-child(2) {
  animation-delay: 0.1s;
}

.tab-enter-active > view:nth-child(3) {
  animation-delay: 0.16s;
}

.tab-enter-active > view:nth-child(4) {
  animation-delay: 0.22s;
}

.tab-enter-active > view:nth-child(5) {
  animation-delay: 0.28s;
}

.tab-enter-active > view:nth-child(6) {
  animation-delay: 0.34s;
}
